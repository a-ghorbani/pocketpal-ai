require 'shellwords'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions setup helper (resolved via node for hoisting).
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native-permissions/scripts/setup.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Log the minimum iOS version
ios_version = min_ios_version_supported
Pod::UI.puts "📱 Minimum iOS version supported: #{ios_version}".green

platform :ios, ios_version
prepare_react_native_project!

# Compile only the Microphone permission handler (on-device voice input).
setup_permissions(['Microphone'])

# linkage = ENV['USE_FRAMEWORKS']
# if linkage != nil
#   Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
#   use_frameworks! :linkage => linkage.to_sym
# end
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

ENV['RCT_NEW_ARCH_ENABLED'] = '1'
ENV['RNLLAMA_BUILD_FROM_SOURCE'] = '1'

def exclude_x86_64_simulator(project)
  project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
  end
end

# The AppIntents wrapper includes llama.rn's core headers, which only the
# llama-rn pod's own header paths resolve (common.h before ggml-cpu/common.h).
def add_llama_rn_headers_to_wrapper(installer, user_project)
  pod_target = installer.pod_targets.find { |t| t.name == 'llama-rn' } or
    raise Pod::Informative, 'llama-rn pod target not found'
  search_paths = pod_target.root_spec.consumer(:ios).pod_target_xcconfig['HEADER_SEARCH_PATHS'] or
    raise Pod::Informative, 'llama-rn sets no HEADER_SEARCH_PATHS'
  pod_dir = Pathname.new(installer.sandbox.pod_dir('llama-rn')).realpath
  pod_dir_from_srcroot = pod_dir.relative_path_from(Pathname.new(user_project.project_dir).realpath)
  flags = Shellwords.split(search_paths)
    .reject { |path| path == '$(inherited)' }
    .map { |path| %(-I"#{path.sub('$(PODS_TARGET_SRCROOT)', "$(SRCROOT)/#{pod_dir_from_srcroot}")}") }
    .join(' ')

  app_target = user_project.native_targets.find { |t| t.name == 'PocketPal' } or
    raise Pod::Informative, 'PocketPal target not found'
  wrapper = app_target.source_build_phase.files.find { |f| f.file_ref&.display_name == 'LlamaContextWrapper.mm' } or
    raise Pod::Informative, 'LlamaContextWrapper.mm is not in the PocketPal Sources phase'
  wrapper.settings = (wrapper.settings || {}).merge('COMPILER_FLAGS' => flags)
end

podfile_dir = Pathname.new(__dir__).realpath
from_srcroot = ->(path) { Pathname.new(path).relative_path_from(podfile_dir).to_s }
llama_rn_dir = Pathname.new(Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "llama.rn/package.json",
    {paths: [process.argv[1]]},
  )', __dir__]).strip).realpath.dirname
ggml_src_dir = llama_rn_dir.join('vendor/llama.cpp/ggml/src')
ggml_metal_dir = ggml_src_dir.join('ggml-metal')
metal_kernels = ggml_metal_dir.join('ggml-metal-device.m').read[/^#define GGML_METAL_LIBS((?:.*\\\n)+.*)/, 1]
  .to_s.scan(/X\(\s*\w+\s*,\s*(\w+)\s*\)/).flatten
raise Pod::Informative, 'No GGML_METAL_LIBS kernels found in llama.rn' if metal_kernels.empty?
missing_kernels = metal_kernels.reject { |name| ggml_metal_dir.join("kernels/#{name}.metal").file? }
raise Pod::Informative, "llama.rn Metal kernels missing: #{missing_kernels.join(', ')}" unless missing_kernels.empty?
metal_kernel_files = ggml_metal_dir.join('kernels').children.select(&:file?).sort
metal_headers = [ggml_metal_dir.join('ggml-metal-impl.h'), ggml_src_dir.join('ggml-common.h')]
metallib_script = podfile_dir.join('../scripts/build-ios-metallib.sh')
app_resources_dir = '$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)'

target 'PocketPal' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  script_phase :name => 'Build llama.rn Metal kernels',
    :execution_position => :before_compile,
    :input_files => [*metal_kernel_files, *metal_headers, metallib_script]
      .map { |path| "$(SRCROOT)/#{from_srcroot.(path)}" },
    :output_files => [
      "#{app_resources_dir}/rnllama.metallib",
      *metal_kernel_files.map { |path| "#{app_resources_dir}/kernels/#{path.basename}" },
      *metal_headers.map { |path| "#{app_resources_dir}/#{path.basename}" },
    ],
    :script => %("${SRCROOT}/#{from_srcroot.(metallib_script)}" "${SRCROOT}/#{from_srcroot.(ggml_src_dir)}" ) +
      metal_kernels.join(' ')

  # # Required for Firebase with New Architecture
  # pod 'Firebase',         :modular_headers => true
  # pod 'FirebaseCore',     :modular_headers => true
  # pod 'FirebaseAppCheck', :modular_headers => true
  # pod 'GoogleUtilities',  :modular_headers => true

  # # Native module for @react-native-firebase/app-check
  # pod 'RNFBAppCheck', :path => '../node_modules/@react-native-firebase/app-check'

  target 'PocketPalTests' do
    inherit! :search_paths
    # Pods for testing
  end

  # Uncomment this line if you're not using auto-linking or if auto-linking causes trouble
  # pod 'WatermelonDB', path: '../node_modules/@nozbe/watermelondb'
  
  # WatermelonDB dependency, should not be needed on modern React Native
  # (please file an issue if this causes issues for you)
  # pod 'React-jsi', path: '../node_modules/react-native/ReactCommon/jsi', modular_headers: true
  
  # WatermelonDB dependency
  pod 'simdjson', path: '../node_modules/@nozbe/simdjson', modular_headers: true

  # Mustache template rendering for iOS Shortcuts
  pod 'GRMustache.swift'

  # Force llama-rn and whisper-rn to build as static libraries. Both vendor a
  # ggml fork whose headers share filenames (ggml.h, ggml-cpu.h, ...); under
  # use_frameworks! the framework header-copy phases otherwise collide
  # ("Multiple commands produce .../Headers/ggml-*.h"). Static linkage skips
  # the framework Headers dir. The two ggml forks use disjoint symbol
  # namespaces (lm_ggml_* vs wsp_ggml_*), so there is no link-time collision.
  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if pod.name == 'llama-rn' ||
         pod.name.start_with?('llama') ||
         pod.name == 'whisper-rn' ||
         pod.name.start_with?('whisper')
        puts "Forcing #{pod.name} to static_library build type"
        def pod.build_type
          Pod::BuildType.static_library
        end
      end
    end
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Workaround: pin the fmt pod to C++17 so it skips the consteval code path
    # that Apple clang 21 (Xcode 26.4.1) rejects. Tracking facebook/react-native#55601.
    # Remove once RN vendors a fmt release that is clang-21-compatible.
    # glog's logging.h includes log_severity.h and vlog_is_on.h inside
    # namespace google, which is illegal as a module import once a Swift C++
    # interop target (NitroModules) imports the React headers. Keep those two
    # headers textual in glog's module map.
    if installer.pods_project.targets.any? { |t| t.name == 'glog' }
      glog_modulemap = File.join(installer.sandbox.root, 'Target Support Files', 'glog', 'glog-textual.modulemap')
      File.write(glog_modulemap, <<~MODULEMAP)
        framework module glog {
          umbrella header "glog-umbrella.h"
          textual header "log_severity.h"
          textual header "vlog_is_on.h"
          export *
          module * { export * }
        }
      MODULEMAP
    end

    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
      if target.name == 'glog'
        target.build_configurations.each do |config|
          config.build_settings['MODULEMAP_FILE'] = '${PODS_ROOT}/Target Support Files/glog/glog-textual.modulemap'
        end
      end
    end

    exclude_x86_64_simulator(installer.pods_project)
    installer.aggregate_targets.map(&:user_project).uniq(&:path).each do |user_project|
      exclude_x86_64_simulator(user_project)
      add_llama_rn_headers_to_wrapper(installer, user_project)
      user_project.save
    end
  end


end
