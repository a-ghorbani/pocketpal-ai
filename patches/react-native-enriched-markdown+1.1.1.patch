+NSString *const ENRMTableTextRowAttribute = @"ENRMTableTextRow";
+
+/// Draws a table that sits inside a list item as text rows, cells joined by " | ",
+/// header row bold. Root tables get their own segment view and never reach here.
+@interface ENRMTableTextRenderer : BaseRenderer
+@end
+
+@implementation ENRMTableTextRenderer
+
+- (void)renderNodeContent:(MarkdownASTNode *)node
+                     into:(NSMutableAttributedString *)output
+                  context:(RenderContext *)context
+{
+  if (context.listDepth == 0) {
+    [_rendererFactory renderChildrenOfNode:node into:output context:context];
+    return;
+  }
+  if (output.length > 0 && ![output.string hasSuffix:@"\n"]) {
+    [output appendAttributedString:kNewlineAttributedString];
+  }
+  [self renderRowsOf:node into:output context:context];
+}
+
+- (void)renderRowsOf:(MarkdownASTNode *)node into:(NSMutableAttributedString *)output context:(RenderContext *)context
+{
+  for (MarkdownASTNode *child in node.children) {
+    if (child.type != MarkdownNodeTypeTableRow) {
+      [self renderRowsOf:child into:output context:context];
+      continue;
+    }
+    BOOL isHeader = NO;
+    MarkdownASTNode *row = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeTableRow];
+    for (MarkdownASTNode *cell in child.children) {
+      isHeader = isHeader || cell.type == MarkdownNodeTypeTableHeaderCell;
+      if (row.children.count > 0) {
+        MarkdownASTNode *separator = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeText];
+        separator.content = @" | ";
+        [row addChild:separator];
+      }
+      [row addChild:cell];
+    }
+    NSUInteger rowStart = output.length;
+    if (isHeader) {
+      row.type = MarkdownNodeTypeStrong;
+      [[_rendererFactory rendererForNodeType:MarkdownNodeTypeStrong] renderNode:row into:output context:context];
+    } else {
+      [_rendererFactory renderChildrenOfNode:row into:output context:context];
+    }
+    if (output.length > rowStart) {
+      [output addAttribute:ENRMTableTextRowAttribute value:@YES range:NSMakeRange(rowStart, output.length - rowStart)];
+    }
+    [output appendAttributedString:kNewlineAttributedString];
+  }
+}
+
+@end
+
 @implementation RendererFactory {
   StyleConfig *_config;
   NSMutableDictionary<NSNumber *, id<NodeRenderer>> *_cache;
