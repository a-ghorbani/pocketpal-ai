+package com.swmansion.enriched.markdown.renderer
+
+import android.text.SpannableStringBuilder
+import com.swmansion.enriched.markdown.parser.MarkdownASTNode
+import com.swmansion.enriched.markdown.spans.StrongSpan
+import com.swmansion.enriched.markdown.spans.TextSpan
+import com.swmansion.enriched.markdown.utils.text.span.SPAN_FLAGS_EXCLUSIVE_EXCLUSIVE
+
+/**
+ * Draws a table that sits inside a list item as text rows, cells joined by " | ",
+ * header row bold. Root tables get their own segment view and never reach here.
+ */
+class TableTextRenderer : NodeRenderer {
+  override fun render(
+    node: MarkdownASTNode,
+    builder: SpannableStringBuilder,
+    onLinkPress: ((String) -> Unit)?,
+    onLinkLongPress: ((String) -> Unit)?,
+    factory: RendererFactory,
+  ) {
+    if (factory.blockStyleContext.listDepth == 0) return
+    if (builder.isNotEmpty() && builder.last() != '\n') builder.append("\n")
+    renderRows(node, builder, onLinkPress, onLinkLongPress, factory)
+  }
+
+  private fun renderRows(
+    node: MarkdownASTNode,
+    builder: SpannableStringBuilder,
+    onLinkPress: ((String) -> Unit)?,
+    onLinkLongPress: ((String) -> Unit)?,
+    factory: RendererFactory,
+  ) {
+    for (child in node.children) {
+      if (child.type != MarkdownASTNode.NodeType.TableRow) {
+        renderRows(child, builder, onLinkPress, onLinkLongPress, factory)
+        continue
+      }
+      val rowStart = builder.length
+      child.children.forEachIndexed { index, cell ->
+        if (index > 0) {
+          factory.renderWithSpan(builder, { builder.append(" | ") }) { start, end, blockStyle ->
+            builder.setSpan(TextSpan(blockStyle, factory.context), start, end, SPAN_FLAGS_EXCLUSIVE_EXCLUSIVE)
+          }
+        }
+        factory.renderChildren(cell, builder, onLinkPress, onLinkLongPress)
+      }
+      val isHeader = child.children.any { it.type == MarkdownASTNode.NodeType.TableHeaderCell }
+      if (isHeader && builder.length > rowStart) {
+        val blockStyle = factory.blockStyleContext.requireBlockStyle()
+        builder.setSpan(StrongSpan(factory.styleCache, blockStyle), rowStart, builder.length, SPAN_FLAGS_EXCLUSIVE_EXCLUSIVE)
+      }
+      if (builder.length > rowStart) {
+        builder.setSpan(TableTextRowSpan(), rowStart, builder.length, SPAN_FLAGS_EXCLUSIVE_EXCLUSIVE)
+      }
+      builder.append("\n")
+    }
+  }
+}
+
+/** Marks a table row drawn as text, so Copy as Markdown indents it instead of repeating the item marker. */
+class TableTextRowSpan
