      },
      "flagship_A": {
        "name": "iPhone 17 Pro / Pro Max / Air",
        "chip": "A18 Pro / A19 / A19 Pro",
        "ram_band": "8-plus"
      },
      "flagship_M": {
        "name": "iPad Pro M2+ / iPad Air M3+",
        "chip": "M2 / M3 / M4 / M5",
        "ram_band": "8-plus"
      }
    },
    "flagship_split_note": "Flagship is bifurcated: A-Pro iPhones ≈ 12-15 TG vs M-series 22-29 TG on 3-4B Q4_K_M. Floor is checked on flagship_A (conservative); numbers that only clear on M-series are listed but flagged as 'iPad/Mac usable'.",
    "os_killer_margin": "iOS jetsam: 6 GiB iPhone tolerates ~1.7 GB peak (Bonsai-8B Q1_0); 8 GiB iPhone ~3-3.5 GB; M-series iPad 8+ GiB ~6 GB. Used to exclude Qwen3.5-9B Q4_K_M on 8 GiB iPhones."
  },
