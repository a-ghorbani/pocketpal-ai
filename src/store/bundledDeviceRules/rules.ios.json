      "low": 5,
      "mid": 8,
      "high": 10,
      "flagship": 12
    },
    "rep_devices": {
      "low": {
        "name": "iPhone XR / iPhone 11",
        "chip": "A12 / A13",
        "ram_band": "3-4"
      },
      "mid": {
        "name": "iPhone 13 Pro (iPhone14,2)",
        "chip": "A15",
        "ram_band": "4-6"
      },
      "high": {
